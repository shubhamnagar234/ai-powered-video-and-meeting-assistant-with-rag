# Virtual Environments
# Ignores virtual environment folders which can be recreated.
.venv
venv
env
ENV

# Python cache files
# Ignores files generated by Python during execution.
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE-specific files
# Ignores configuration files for popular editors like VS Code and PyCharm.
.vscode/
.idea/

# Environment variables
# Ignores files that may contain sensitive data like API keys.
.env

# Build and distribution artifacts
# Ignores folders created when you build or package your project.
build/
dist/
*.egg-info/

# Test outputs
# Ignores cache and reports generated by testing tools.
.pytest_cache/
htmlcov/

# OS-specific files
# Ignores system files generated by macOS and Windows.
.DS_Store
Thumbs.db